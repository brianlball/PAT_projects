  <class_name>SetInteriorWallConstructionForSpaces</class_name>
  <display_name>Set Interior Wall Construction for Spaces (Strict)</display_name>
  <description>Assigns the given Construction (default: 'Typical Interior Wall') to interzone walls between spaces ONLY when both adjacent spaces are in the provided list. Exterior/adiabatic walls are not modified.</description>
  <modeler_description>Resolves input space names to handles once, then uses handle-string comparison for all matching. For each interzone wall whose two spaces are both targeted, sets the Construction on BOTH mate surfaces.</modeler_description>
  <arguments>
    <argument>
      <name>space_names</name>
      <display_name>Target Spaces (comma-separated exact names)</display_name>
      <description>Case-insensitive exact match to Space names. Example: "Space 101, Space 102".</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>Space 101, Space 102, Space 103, Space 104, Space 105, Space 106, Space 107, Space 108, Space 109, Space 110, Space 111, Space 112, Space 113, Space 114, Space 115, Space 117, Space 118</default_value>
    </argument>
    <argument>
      <name>construction_name</name>
      <display_name>Construction Name to Apply</display_name>
      <description>Must exist in the model. Applied only to interzone walls whose adjacent space is also targeted.</description>
      <type>String</type>
      <required>true</required>
      <model_dependent>false</model_dependent>
      <default_value>Typical Interior Wall</default_value>
    </argument>
  </arguments>
  <outputs />
